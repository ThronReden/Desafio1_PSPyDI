<Window x:Class="Biblioteca_V2.PrestamosWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Préstamos" Height="420" Width="1000"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Préstamos" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <DataGrid x:Name="dgDatos" Grid.Row="1"
                  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="40"/>
                <DataGridTextColumn Header="Libro (ejemplar)" Binding="{Binding Ejemplar.Libro.Titulo, Mode=OneWay}" Width="*"/>
                <DataGridTextColumn Header="Ej." Binding="{Binding EjemplarId}" Width="40"/>
                <DataGridTextColumn Header="Socio" Binding="{Binding Socio.NombreCompleto, Mode=OneWay}" Width="*"/>
                <DataGridTextColumn Header="F. préstamo" Binding="{Binding FechaPrestamo, StringFormat=d}" Width="100"/>
                <DataGridTextColumn Header="F. esperada" Binding="{Binding FechaEsperadaEntrega, StringFormat=d}" Width="100"/>
                <DataGridTextColumn Header="F. entrega" Binding="{Binding FechaEntrega, StringFormat=d}" Width="100"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado, Mode=OneWay}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Content="Volver" Width="90" Margin="0,10,0,0"
                HorizontalAlignment="Right" Click="Volver_Click"/>
    </Grid>
</Window>
