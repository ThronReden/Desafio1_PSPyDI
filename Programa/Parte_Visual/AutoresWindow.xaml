<Window x:Class="Parte_Visual.AutoresWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestor de Autores"
        Height="540" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5F5F5">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="GESTOR DE AUTORES"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <GroupBox Header="Listado de autores"
                  Margin="0,0,0,10"
                  Grid.Row="1"
                  Background="#E8F0FE"
                  BorderBrush="#B0C4DE"
                  BorderThickness="1">
            <DataGrid x:Name="dgDatos"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      Background="White"
                      GridLinesVisibility="Horizontal"
                      RowBackground="White"
                      AlternatingRowBackground="#F0F8FF"
                      SelectionChanged="dgDatos_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                    <DataGridTextColumn Header="Apellidos" Binding="{Binding Apellidos}" Width="*"/>
                    <DataGridTextColumn Header="Nacionalidad" Binding="{Binding Nacionalidad}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GroupBox Header="Datos del autor"
                  Grid.Row="2"
                  Background="#E8F0FE"
                  BorderBrush="#B0C4DE"
                  BorderThickness="1">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Nombre:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtNombre" Grid.Row="0" Grid.Column="1" Margin="5"/>
                <TextBlock Text="Apellidos:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"/>
                <TextBox x:Name="txtApellidos" Grid.Row="0" Grid.Column="3" Margin="5"/>
                <TextBlock Text="Nacionalidad:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtNacionalidad" Grid.Row="1" Grid.Column="1" Margin="5"/>

                <!-- Botones -->
                <StackPanel Grid.Row="2"
                            Grid.ColumnSpan="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,15,0,0">

                    <Button Content="Nuevo" Width="90" Margin="0,0,10,0"
                            Click="Nuevo_Click" Background="#3498DB" Foreground="White" FontWeight="Bold"/>

                    <Button Content="Guardar" Width="90" Margin="0,0,10,0"
                            Click="Guardar_Click" Background="#27AE60" Foreground="White" FontWeight="Bold"/>

                    <Button Content="Eliminar" Width="90" Margin="0,0,10,0"
                            Click="Eliminar_Click" Background="#E74C3C" Foreground="White" FontWeight="Bold"/>

                    <Button Content="Volver" Width="90" Click="Volver_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
