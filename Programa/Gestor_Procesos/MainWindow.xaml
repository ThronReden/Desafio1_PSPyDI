<Window x:Class="Gestor_Procesos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema de Biblioteca"
        Height="560" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#F2F2F2">

    <Window.Resources>
        <Style x:Key="BotonMenu" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Background="#2C3E50">
        <Border Width="400"
                Padding="30"
                Background="#ECF0F1"
                CornerRadius="15"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <TextBlock Text="BIBLIOTECA"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#2C3E50"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>
                <TextBlock Text="Selecciona una opción"
                           FontSize="14"
                           Foreground="Gray"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <Button Content="Autores"    Style="{StaticResource BotonMenu}" Click="AbrirAutores_Click"/>
                <Button Content="Libros"     Style="{StaticResource BotonMenu}" Click="AbrirLibros_Click"/>
                <Button Content="Ejemplares" Style="{StaticResource BotonMenu}" Click="AbrirEjemplares_Click"/>
                <Button Content="Socios"     Style="{StaticResource BotonMenu}" Click="AbrirSocios_Click"/>
                <Button Content="Préstamos"  Style="{StaticResource BotonMenu}" Click="AbrirPrestamos_Click"/>
                <Button Content="Salir"      Style="{StaticResource BotonMenu}" Click="Salir_Click" Background="#E74C3C"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
