<Window x:Class="Biblioteca_V2.LibrosWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Libros" Height="420" Width="1050"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Libros" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <DataGrid x:Name="dgDatos" Grid.Row="1"
                  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="40"/>
                <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="*"/>
                <DataGridTextColumn Header="Autor" Binding="{Binding Autor.NombreCompleto, Mode=OneWay}" Width="*"/>
                <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="140"/>
                <DataGridTextColumn Header="Género" Binding="{Binding Genero}" Width="90"/>
                <DataGridTextColumn Header="F. publicación" Binding="{Binding FechaPublicacion, StringFormat=d}" Width="110"/>
                <DataGridTextColumn Header="Edición" Binding="{Binding Edicion}" Width="65"/>
                <DataGridTextColumn Header="Editorial" Binding="{Binding Editorial}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Content="Volver" Width="90" Margin="0,10,0,0"
                HorizontalAlignment="Right" Click="Volver_Click"/>
    </Grid>
</Window>
