<Window x:Class="Parte_Visual.LibrosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestor de Libros"
        Height="600" Width="1050"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5F5F5">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="GESTOR DE LIBROS"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <GroupBox Header="Listado de libros"
                  Margin="0,0,0,10"
                  Grid.Row="1"
                  Background="#E8F0FE"
                  BorderBrush="#B0C4DE"
                  BorderThickness="1">
            <DataGrid x:Name="dgDatos"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      Background="White"
                      GridLinesVisibility="Horizontal"
                      RowBackground="White"
                      AlternatingRowBackground="#F0F8FF"
                      SelectionChanged="dgDatos_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45"/>
                    <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="*"/>
                    <DataGridTextColumn Header="Autor" Binding="{Binding Autor.NombreCompleto, Mode=OneWay}" Width="*"/>
                    <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="140"/>
                    <DataGridTextColumn Header="Género" Binding="{Binding Genero}" Width="90"/>
                    <DataGridTextColumn Header="F. publicación" Binding="{Binding FechaPublicacion, StringFormat=d}" Width="110"/>
                    <DataGridTextColumn Header="Edición" Binding="{Binding Edicion}" Width="65"/>
                    <DataGridTextColumn Header="Editorial" Binding="{Binding Editorial}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GroupBox Header="Datos del libro"
                  Grid.Row="2"
                  Background="#E8F0FE"
                  BorderBrush="#B0C4DE"
                  BorderThickness="1">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Título:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtTitulo" Grid.Row="0" Grid.Column="1" Margin="5"/>
                <TextBlock Text="Autor:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbAutor" DisplayMemberPath="NombreCompleto" Grid.Row="0" Grid.Column="3" Margin="5"/>
                <TextBlock Text="ISBN:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtISBN" Grid.Row="1" Grid.Column="1" Margin="5"/>
                <TextBlock Text="Género:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbGenero"  Grid.Row="1" Grid.Column="3" Margin="5"/>
                <TextBlock Text="F. publicación:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                <DatePicker x:Name="dpFechaPublicacion" Grid.Row="2" Grid.Column="1" Margin="5"/>
                <TextBlock Text="Edición:" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"/>
                <TextBox x:Name="txtEdicion" Grid.Row="2" Grid.Column="3" Margin="5"/>
                <TextBlock Text="Editorial:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtEditorial" Grid.Row="3" Grid.Column="1" Margin="5"/>

                <!-- Botones -->
                <StackPanel Grid.Row="4"
                            Grid.ColumnSpan="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,15,0,0">

                    <Button Content="Nuevo" Width="90" Margin="0,0,10,0"
                            Click="Nuevo_Click" Background="#3498DB" Foreground="White" FontWeight="Bold"/>

                    <Button Content="Guardar" Width="90" Margin="0,0,10,0"
                            Click="Guardar_Click" Background="#27AE60" Foreground="White" FontWeight="Bold"/>

                    <Button Content="Eliminar" Width="90" Margin="0,0,10,0"
                            Click="Eliminar_Click" Background="#E74C3C" Foreground="White" FontWeight="Bold"/>

                    <Button Content="Volver" Width="90" Click="Volver_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
